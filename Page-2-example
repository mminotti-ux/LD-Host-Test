<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Testing Data as a Future Simulation — Week 5 | MS in AI in Business</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@0,400;0,600;0,700;0,800;0,900;1,400;1,700&family=Barlow:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,500&display=swap" rel="stylesheet">
<style>
:root {
  --red: #CC0000;
  --cherry: #A71930;
  --teal: #63C4AF;
  --teal-dark: #2d8f7a;
  /* --teal-dark is 3.95:1 on --card, which clears the 3:1 required of borders and
     fills but not the 4.5:1 required of text. --teal-text is the text-safe variant:
     5.21:1 on --card, 4.91:1 on --bg. */
  --teal-text: #27796a;
  --blue: #005293;
  --ink: #13110f;
  --ink-2: #3a3330;
  --muted: #6b6360;
  /* --faint darkened from #9e9895 (2.85:1 on white, fails WCAG 2.2 AA 1.4.3)
     to #726c69: 5.17:1 on --card, 4.87:1 on --bg. */
  --faint: #726c69;
  --line: rgba(20,17,15,.09);
  --line-med: rgba(20,17,15,.14);
  --bg: #f9f8f7;
  --card: #ffffff;
  --max-shell: 860px;
  --max-read: 680px;
  --fb: "Barlow",Arial,sans-serif;
  --fd: "Barlow Condensed",Arial,sans-serif;
}
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; }
body { font-family: var(--fb); background: var(--bg); color: var(--ink); line-height: 1.65; -webkit-font-smoothing: antialiased; }
a { color: inherit; }
:focus-visible { outline: 2px solid var(--blue); outline-offset: 3px; border-radius: 4px; }
.skip-link { position: absolute; left: 16px; top: -60px; background: var(--blue); color: #fff; padding: 10px 14px; border-radius: 0 0 8px 8px; z-index: 999; font-weight: 600; font-size: .88rem; }
.skip-link:focus { top: 0; }

/* ── NAV ── */
/* ── BRAND BAR ── */
/* ── PROGRESS ── */
.progress-wrap { position: sticky; top: 0; z-index: 50; background: rgba(255,255,255,.9); backdrop-filter: blur(8px); border-bottom: 1px solid var(--line); }
.progress-bar { height: 4px; background: linear-gradient(90deg, #CC0000 0%, var(--cherry) 55%, var(--teal) 100%); width: 0%; transition: width .1s; }

/* ── ARTICLE SHELL ── */
.article-shell { max-width: var(--max-shell); margin: 0 auto; padding: 52px 32px 80px; }

/* ── ARTICLE HEADER ── */
.article-header { max-width: var(--max-read); margin: 0 auto 48px; }
.article-title { font-family: var(--fd); font-size: clamp(2rem,5vw,3rem); line-height: 1.06; letter-spacing: -.01em; margin-bottom: 18px; }
.article-title em { font-style: italic; color: var(--cherry); }
.article-lead { font-size: 1.1rem; color: var(--muted); line-height: 1.75; max-width: 60ch; padding-bottom: 24px; border-bottom: 1px solid var(--line-med); }

/* ── ARTICLE BODY ── */
.article-body { max-width: var(--max-read); margin: 0 auto; font-size: 1.02rem; line-height: 1.82; color: var(--muted); }
.article-body h2 { font-family: var(--fd); font-size: clamp(1.4rem,2.5vw,1.85rem); line-height: 1.15; letter-spacing: -.01em; color: var(--ink); margin: 44px 0 14px; padding-bottom: 10px; border-bottom: 1px solid var(--line-med); }
.article-body p { margin-bottom: 20px; }
.article-body p:last-child { margin-bottom: 0; }
.article-body strong { color: var(--ink); font-weight: 600; }

/* ── VOCAB TERMS (accessible disclosure: select to reveal definition in-flow) ── */
.vocab-term {
  background: rgba(99,196,175,.12); color: var(--teal-text);
  padding: 1px 5px; border-radius: 4px; font-weight: 600;
  border: none; font: inherit; line-height: inherit;
  cursor: pointer; -webkit-appearance: none; appearance: none;
  text-decoration: underline; text-decoration-style: dotted;
  text-underline-offset: 3px; text-decoration-thickness: 2px;
}
.vocab-term:hover { background: rgba(99,196,175,.18); }
.vocab-term:focus-visible { outline: 2px solid var(--blue); outline-offset: 2px; }
.vocab-term[aria-expanded="true"] { background: rgba(99,196,175,.20); text-decoration-style: solid; }
.vocab-sr {
  position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
  overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0;
}
.vocab-definition {
  display: block; margin: 10px 0 16px; padding: 12px 16px;
  background: var(--card); border: 1px solid var(--line-med);
  border-left: 3px solid var(--teal-dark); border-radius: 0 10px 10px 0;
  font-size: .92rem; line-height: 1.6; color: var(--ink-2);
  max-width: 62ch; font-family: var(--fb);
}
.vocab-definition[hidden] { display: none; }

/* ── LISTS ── */
.article-body ul { margin: 6px 0 24px; padding: 0; list-style: none; display: grid; gap: 8px; }
.article-body ul li { padding-left: 18px; position: relative; font-size: 1rem; color: var(--muted); line-height: 1.72; }
.article-body ul li::before { content: ''; position: absolute; left: 0; top: .68em; width: 6px; height: 6px; border-radius: 50%; background: var(--teal-dark); flex-shrink: 0; }

/* ── CALLOUT ── */
.callout { margin: 28px 0; padding: 18px 20px 18px 22px; background: var(--card); border: 1px solid var(--line-med); border-left: 3px solid var(--teal-dark); border-radius: 0 12px 12px 0; }
.callout-label { font-size: .67rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--teal-text); margin-bottom: 7px; }
.callout p { font-size: .93rem; margin-bottom: 0; color: var(--ink-2); line-height: 1.72; }

/* ── PULL QUOTE ── */
.pull-quote { margin: 36px 0; padding: 24px 24px 20px; text-align: center; border-top: 2px solid var(--cherry); border-bottom: 2px solid var(--cherry); }
.pull-quote p { font-family: var(--fd); font-size: 1.25rem; font-style: italic; color: var(--ink); margin: 0; line-height: 1.45; }

/* ── SECTION DIVIDER ── */
.sec-divider { display: flex; align-items: center; gap: 14px; margin: 44px 0 0; }
.sec-divider-label { font-size: .67rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--teal-text); white-space: nowrap; }
.sec-divider-rule { flex: 1; height: 1px; background: var(--line-med); }

/* ── FUTURE-FIT MINI-SIMULATION ── */
.activity-wrap { max-width: 780px; margin: 28px auto 0; }
.activity-card { background: var(--card); border: 1px solid var(--line-med); border-radius: 16px; overflow: hidden; box-shadow: 0 12px 32px rgba(20,17,15,.06); }
.activity-head { padding: 20px 24px; border-bottom: 1px solid var(--line); display: flex; align-items: flex-start; gap: 14px; }
.activity-icon { width: 38px; height: 38px; border-radius: 10px; flex-shrink: 0; background: rgba(167,25,48,.08); border: 1px solid rgba(167,25,48,.16); display: grid; place-items: center; }
.activity-icon svg { width: 18px; height: 18px; stroke: var(--cherry); fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
.activity-title { font-family: var(--fd); font-size: 1.25rem; font-weight: 700; color: var(--ink); line-height: 1.25; margin: 0; }
.activity-kicker { font-size: .82rem; color: var(--muted); line-height: 1.55; margin-top: 4px; }
.activity-body { padding: 24px; }
.activity-intro { font-size: .95rem; color: var(--muted); line-height: 1.7; margin-bottom: 18px; }
.sr-only { position: absolute !important; width: 1px !important; height: 1px !important; padding: 0 !important; margin: -1px !important; overflow: hidden !important; clip: rect(0,0,0,0) !important; white-space: nowrap !important; border: 0 !important; }

.lens-group { display: grid; grid-template-columns: repeat(5,minmax(0,1fr)); gap: 8px; margin-bottom: 22px; }
.lens-btn { min-height: 48px; padding: 9px 8px; border: 1px solid var(--line-med); border-radius: 10px; background: var(--card); color: var(--ink-2); font: 600 .78rem/1.25 var(--fb); cursor: pointer; }
.lens-btn:hover { background: rgba(45,143,122,.06); border-color: rgba(45,143,122,.38); }
.lens-btn[aria-pressed="true"] { background: var(--ink); border-color: var(--ink); color: #fff; }

.sim-scenario { background: rgba(20,17,15,.035); border: 1px solid var(--line); border-radius: 12px; padding: 18px 20px; margin-bottom: 18px; }
.sim-scenario h4 { font-family: var(--fd); font-size: 1.15rem; line-height: 1.25; color: var(--ink); margin-bottom: 6px; }
.sim-scenario p { font-size: .9rem; color: var(--muted); line-height: 1.65; }
.sim-data-note { font-size: .76rem; color: var(--muted); margin-top: 10px; line-height: 1.6; }

.sim-chart { border: 1px solid var(--line-med); border-radius: 14px; padding: 20px; }
.sim-chart h4 { font-family: var(--fd); font-size: 1.1rem; color: var(--ink); margin-bottom: 4px; }
.sim-chart-intro { font-size: .82rem; color: var(--muted); line-height: 1.55; margin-bottom: 16px; }
.mix-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 16px; }
.mix-label { display: flex; justify-content: space-between; gap: 10px; color: var(--ink-2); font-size: .78rem; font-weight: 600; margin-bottom: 6px; }
.mix-bar { display: flex; height: 34px; overflow: hidden; border-radius: 8px; background: var(--bg); border: 1px solid var(--line); }
.mix-segment { display: flex; align-items: center; justify-content: center; min-width: 0; font-size: .72rem; font-weight: 700; transition: width .35s ease; }
.mix-segment-a { background: rgba(45,143,122,.24); color: #184f43; }
.mix-segment-b { background: rgba(167,25,48,.17); color: #751123; }
.mix-legend { display: flex; flex-wrap: wrap; gap: 10px 18px; margin: 12px 0 20px; }
.mix-legend-item { display: flex; align-items: center; gap: 6px; font-size: .76rem; color: var(--muted); }
.mix-swatch { width: 11px; height: 11px; border-radius: 3px; flex-shrink: 0; }
.mix-swatch-a { background: rgba(45,143,122,.52); }
.mix-swatch-b { background: rgba(167,25,48,.42); }

.performance-title { font-size: .78rem; font-weight: 700; color: var(--ink-2); margin-bottom: 3px; }
/* Takeaway box: the point a section turns on */
.takeaway { margin: 22px 0; padding: 16px 20px; background: rgba(99,196,175,.07); border: 1px solid rgba(99,196,175,.30); border-left: 3px solid var(--teal-text); border-radius: 0 12px 12px 0; max-width: 680px; }
.takeaway-label { font-size: .67rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--teal-text); margin-bottom: 7px; }
.takeaway-text { font-size: .96rem; font-weight: 600; line-height: 1.65; color: var(--ink); margin: 0; }
@media (forced-colors: active) { .takeaway { border: 1px solid CanvasText; border-left: 3px solid CanvasText; } }
.performance-note { font-size: .76rem; color: var(--muted); line-height: 1.6; margin-bottom: 12px; }
.performance-grid { display: grid; gap: 0; margin-bottom: 20px; }
.perf-seg { padding: 13px 0; border-top: 1px solid var(--line); }
.perf-seg:first-child { border-top: 0; padding-top: 4px; }
.perf-seg-head { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; margin-bottom: 7px; }
.performance-label { font-size: .8rem; font-weight: 600; color: var(--ink-2); line-height: 1.35; }
.performance-track { height: 10px; background: rgba(20,17,15,.07); border-radius: 999px; overflow: hidden; }
.performance-fill { height: 100%; border-radius: inherit; transition: width .35s ease; }
.performance-fill-a { background: var(--teal-dark); }
.performance-fill-b { background: var(--cherry); }
.performance-value { font-size: .82rem; font-weight: 700; color: var(--ink-2); text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
.perf-context { font-size: .76rem; color: var(--muted); line-height: 1.65; margin-top: 8px; }
.perf-context span { white-space: nowrap; }
.lift-pos { color: #17513f; font-weight: 700; }
.lift-neg { color: #8a1226; font-weight: 700; }

.sim-control { background: var(--bg); border-radius: 12px; padding: 16px 18px; }
.sim-control-head { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; margin-bottom: 8px; }
.sim-control label { font-size: .82rem; font-weight: 600; color: var(--ink-2); }
.sim-control output { font-family: var(--fd); font-size: 1.1rem; font-weight: 700; color: var(--cherry); font-variant-numeric: tabular-nums; }
.sim-range { width: 100%; accent-color: var(--cherry); cursor: pointer; }
.sim-control-scale { display: flex; justify-content: space-between; gap: 12px; font-size: .74rem; color: var(--muted); margin-top: 3px; }

/* Slider discoverability hint (house pattern from Wk6 threshold simulation):
   a bouncing chevron above the range input, removed permanently on first
   interaction with the slider. */
.sim-hint { display: flex; flex-direction: column-reverse; align-items: center; justify-content: center; gap: 2px; margin: 2px 0 6px; color: var(--cherry); font-weight: 700; font-size: .8rem; text-align: center; }
.sim-hint svg { width: 18px; height: 18px; stroke: currentColor; fill: none; stroke-width: 2.5; stroke-linecap: round; stroke-linejoin: round; flex-shrink: 0; animation: simHintNudge 1.1s ease-in-out 4; }
@keyframes simHintNudge { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(6px); } }
@media (prefers-reduced-motion: reduce) { .sim-hint svg { animation: none; } }
.sim-control-foot { display: flex; justify-content: space-between; align-items: center; gap: 14px; flex-wrap: wrap; margin-top: 12px; }
.sim-target { font-size: .76rem; color: var(--muted); }
.sim-target strong { color: var(--ink-2); }
.btn-quiet { padding: 7px 12px; border: 1px solid var(--line-med); border-radius: 8px; background: var(--card); color: var(--ink-2); font: 600 .76rem var(--fb); cursor: pointer; }
.btn-quiet:hover { border-color: var(--teal-dark); background: rgba(45,143,122,.06); }
/* ── PREDICT-FIRST GATE ── */
.predict-block { background: var(--card); border: 1px solid var(--line-med); border-radius: 12px; padding: 15px 16px; margin-bottom: 16px; }
.predict-prompt { font-size: .84rem; font-weight: 600; color: var(--ink-2); line-height: 1.5; margin-bottom: 4px; }
.predict-hint { font-size: .76rem; color: var(--muted); line-height: 1.55; margin-bottom: 11px; }
.predict-options { display: grid; gap: 8px; }
.predict-option {
  width: 100%; text-align: left; background: var(--bg);
  border: 1.5px solid var(--line-med); border-radius: 10px;
  padding: 10px 13px; cursor: pointer; font: 500 .82rem/1.5 var(--fb); color: var(--ink-2);
  display: flex; align-items: center; gap: 12px;
  box-shadow: 0 1px 2px rgba(20,17,15,.04);
  transition: border-color .18s, background-color .18s, box-shadow .18s, transform .18s;
}
.predict-option:hover:not(:disabled) { border-color: rgba(167,25,48,.32); background: rgba(167,25,48,.04); box-shadow: 0 4px 10px rgba(20,17,15,.08); transform: translateY(-1px); }
.predict-option:active:not(:disabled) { transform: translateY(0); box-shadow: 0 1px 2px rgba(20,17,15,.06); }
.predict-option:disabled { cursor: default; box-shadow: none; }
.predict-option-letter {
  width: 26px; height: 26px; border-radius: 7px; flex-shrink: 0;
  background: rgba(20,17,15,.06); border: 1px solid var(--line-med);
  display: grid; place-items: center;
  font-size: .74rem; font-weight: 700; color: var(--muted);
  transition: all .18s;
}
.predict-option-text { flex: 1; }
.predict-option.chosen-correct { border-color: var(--teal-dark); background: rgba(45,143,122,.09); color: #17513f; }
.predict-option.chosen-correct .predict-option-letter { background: var(--teal-text); border-color: var(--teal-text); color: #fff; }
.predict-option.chosen-incorrect { border-color: var(--cherry); background: rgba(167,25,48,.06); color: #8a1226; }
.predict-option.chosen-incorrect .predict-option-letter { background: var(--cherry); border-color: var(--cherry); color: #fff; }
.predict-result { display: none; margin-top: 11px; font-size: .8rem; line-height: 1.6; color: var(--muted); }
.predict-result.show { display: block; }
.predict-result strong { color: var(--ink-2); }

/* ── PROJECTION ── */
.projection { margin-top: 16px; padding-top: 15px; border-top: 1px solid var(--line-med); }
.projection[hidden] { display: none; }
.projection-label { font-size: .78rem; color: var(--muted); }
.projection-label strong { display: block; color: var(--ink-2); font-size: .84rem; margin-bottom: 3px; }
.projection-stats { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 10px; margin: 12px 0 10px; }
.projection-stat { background: var(--card); border: 1px solid var(--line); border-radius: 10px; padding: 10px 12px; }
.projection-stat-label { font-size: .7rem; font-weight: 600; color: var(--muted); line-height: 1.35; margin-bottom: 4px; }
.projection-value { display: block; font-family: var(--fd); font-size: 1.55rem; font-weight: 700; color: var(--ink); line-height: 1.05; font-variant-numeric: tabular-nums; }
.projection-value.lift-pos { color: #17513f; }
.projection-value.lift-neg { color: #8a1226; }
.projection-caveat { font-size: .76rem; color: var(--muted); line-height: 1.6; margin-top: 11px; padding-left: 11px; border-left: 3px solid var(--line-med); }

.quiz-panel { margin-top: 20px; border-top: 1px solid var(--line); padding-top: 20px; }
.quiz-progress { font-size: .7rem; font-weight: 700; letter-spacing: .09em; text-transform: uppercase; color: var(--teal-text); margin-bottom: 7px; }
.quiz-question { font-family: var(--fd); font-size: 1.16rem; font-weight: 700; color: var(--ink); line-height: 1.3; margin-bottom: 12px; }
.quiz-options { display: grid; gap: 9px; }
.quiz-option {
  width: 100%; text-align: left; background: var(--bg);
  border: 1.5px solid var(--line-med); border-radius: 12px;
  padding: 13px 16px; cursor: pointer; font: 500 .86rem/1.5 var(--fb); color: var(--ink-2);
  display: flex; align-items: center; gap: 13px;
  box-shadow: 0 1px 2px rgba(20,17,15,.04);
  transition: border-color .18s, background-color .18s, box-shadow .18s, transform .18s;
}
.quiz-option:hover:not(:disabled) { border-color: rgba(167,25,48,.32); background: rgba(167,25,48,.04); box-shadow: 0 4px 10px rgba(20,17,15,.08); transform: translateY(-1px); }
.quiz-option:active:not(:disabled) { transform: translateY(0); box-shadow: 0 1px 2px rgba(20,17,15,.06); }
.quiz-option:disabled { cursor: default; box-shadow: none; }
.quiz-option-letter {
  width: 28px; height: 28px; border-radius: 8px; flex-shrink: 0;
  background: rgba(20,17,15,.06); border: 1px solid var(--line-med);
  display: grid; place-items: center;
  font-size: .78rem; font-weight: 700; color: var(--muted);
  transition: all .18s;
}
.quiz-option-text { flex: 1; }
.quiz-option.correct { border-color: var(--teal-dark); background: rgba(45,143,122,.09); color: #184f43; }
.quiz-option.correct .quiz-option-letter { background: var(--teal-text); border-color: var(--teal-text); color: #fff; }
.quiz-option.incorrect { border-color: var(--cherry); background: rgba(167,25,48,.06); color: #751123; }
.quiz-option.incorrect .quiz-option-letter { background: var(--cherry); border-color: var(--cherry); color: #fff; }
.quiz-feedback { display: none; margin-top: 14px; padding: 14px 16px; border-radius: 10px; }
.quiz-feedback.show { display: block; }
.quiz-feedback:focus { outline: 2px solid var(--blue); outline-offset: 3px; }
.quiz-feedback.correct { background: rgba(45,143,122,.08); border: 1px solid rgba(45,143,122,.28); }
.quiz-feedback.incorrect { background: rgba(167,25,48,.06); border: 1px solid rgba(167,25,48,.23); }
.feedback-title { font-size: .82rem; font-weight: 700; color: var(--ink); margin-bottom: 4px; }
.feedback-text { font-size: .84rem; line-height: 1.6; color: var(--muted); }
.feedback-actions { margin-top: 12px; display: flex; gap: 8px; flex-wrap: wrap; }
.btn-action { padding: 8px 15px; border: 1px solid var(--ink); border-radius: 8px; background: var(--ink); color: #fff; font: 600 .8rem var(--fb); cursor: pointer; }
.btn-action:hover { background: #332d29; }
.btn-action.secondary { background: var(--card); color: var(--ink-2); border-color: var(--line-med); }
.btn-action.secondary:hover { border-color: var(--teal-dark); background: rgba(45,143,122,.06); }

.solution-summary { display: none; margin-top: 20px; border-top: 1px solid var(--line); padding-top: 20px; }
.solution-summary.show { display: block; }
.solution-summary:focus { outline: 2px solid var(--blue); outline-offset: 4px; border-radius: 4px; }
.solution-summary h4 { font-family: var(--fd); font-size: 1.18rem; color: var(--ink); margin-bottom: 5px; }
.solution-intro { font-size: .84rem; color: var(--muted); margin-bottom: 12px; }
.solution-list { display: grid; gap: 10px; }
.solution-item { padding: 12px 14px; border-left: 3px solid var(--teal-dark); background: rgba(45,143,122,.055); }
.solution-item strong { display: block; font-size: .78rem; color: var(--ink-2); margin-bottom: 3px; }
.solution-item p { font-size: .82rem; line-height: 1.55; color: var(--muted); }
.solution-actions { margin-top: 14px; }

/* ── REVEAL ── */
.reveal { opacity: 0; transform: translateY(14px); transition: opacity .45s ease, transform .45s ease; }
.reveal.visible { opacity: 1; transform: none; }
.reveal-d1 { transition-delay: .06s; }
.reveal-d2 { transition-delay: .12s; }

/* ── RESPONSIVE ── */
@media (max-width: 640px) {
  .article-shell { padding-top: 36px; }
  .activity-head,.activity-body { padding-left: 18px; padding-right: 18px; }
  .lens-group { grid-template-columns: repeat(2,minmax(0,1fr)); }
