      owners: 'the learner-success leader and institutional analytics owner',
      monitor: 'model errors, outreach participation, and completion outcomes by learner tenure and program format'
    }
  };

  var currentLensKey = 'media';
  var currentStep = 0;
  var lensButtons = Array.prototype.slice.call(document.querySelectorAll('.lens-btn'));
  var mixRange = document.getElementById('mixRange');
  var quizPanel = document.getElementById('quizPanel');
  var quizOptions = document.getElementById('quizOptions');
  var quizFeedback = document.getElementById('quizFeedback');
  var feedbackActions = document.getElementById('feedbackActions');
  var solutionSummary = document.getElementById('solutionSummary');
  var projectionBlock = document.getElementById('projectionBlock');
  var predictBlock = document.getElementById('predictBlock');
  var predictOptions = document.getElementById('predictOptions');
  var predictResult = document.getElementById('predictResult');
  var predictionMade = false;
  var announceTimer = null;
  var OPTION_LETTERS = ['A', 'B', 'C', 'D'];

  function weightedPerformance(lens, shareB) {
    return (((100 - shareB) * lens.perfA) + (shareB * lens.perfB)) / 100;
  }

  /* Accuracy of the simplest possible rule: always predict the majority class. */
  function baselineOf(rate) {
    return Math.max(rate, 100 - rate);
  }

  function weightedBaseline(lens, shareB) {
    return (((100 - shareB) * baselineOf(lens.baseA)) + (shareB * baselineOf(lens.baseB))) / 100;
  }

  /* 95% margin of error on a proportion measured on n records, in percentage points. */
  function marginOfError(pct, n) {
    var p = pct / 100;
    return 1.96 * Math.sqrt((p * (1 - p)) / n) * 100;
  }

  /* False alarm rate, derived so accuracy, outcome rate, and recall stay consistent:
     accuracy = recall x rate + (1 - falseAlarm) x (1 - rate). */
  function falseAlarmRate(accuracy, rate, recall) {
    var r = rate / 100;
    var specificity = ((accuracy / 100) - ((recall / 100) * r)) / (1 - r);
    return (1 - specificity) * 100;
  }

  function formatPct(value) {
    var rounded = Math.round(value * 10) / 10;
    return (rounded % 1 === 0 ? rounded.toFixed(0) : rounded.toFixed(1)) + '%';
  }

  function formatPoints(value) {
    return (Math.round(value * 10) / 10).toFixed(1);
  }

  function formatSigned(value) {
    var rounded = Math.round(value * 10) / 10;
    return (rounded > 0 ? '+' : rounded < 0 ? '−' : '') + Math.abs(rounded).toFixed(1);
  }

  function formatCount(value) {
    return String(value).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
  }

  function setMix(prefix, shareB) {
    var shareA = 100 - shareB;
    var a = document.getElementById(prefix + 'MixA');
    var b = document.getElementById(prefix + 'MixB');
    a.style.width = shareA + '%';
    b.style.width = shareB + '%';
    a.textContent = shareA + '%';
    b.textContent = shareB + '%';
  }

  function segmentFacts(lens, which) {
    var accuracy = which === 'A' ? lens.perfA : lens.perfB;
    var rate = which === 'A' ? lens.baseA : lens.baseB;
    var recall = which === 'A' ? lens.recallA : lens.recallB;
    var n = which === 'A' ? lens.nA : lens.nB;
    var baseline = baselineOf(rate);
    return {
      name: which === 'A' ? lens.groupA : lens.groupB,
      accuracy: accuracy,
      rate: rate,
      recall: recall,
      n: n,
      baseline: baseline,
      lift: accuracy - baseline,
      margin: marginOfError(accuracy, n),
      falseAlarm: falseAlarmRate(accuracy, rate, recall)
    };
  }

  function renderSegmentContext(which, lens) {
    var f = segmentFacts(lens, which);
    var liftClass = f.lift >= 0 ? 'lift-pos' : 'lift-neg';
    document.getElementById('performanceValue' + which).textContent = f.accuracy + '% ±' + formatPoints(f.margin);
    document.getElementById('performanceFill' + which).style.width = f.accuracy + '%';
    document.getElementById('performanceLabel' + which).textContent = f.name;
    document.getElementById('performanceContext' + which).innerHTML =
      '<span>' + formatCount(f.n) + ' tested</span> &middot; <span>' + f.rate + '% ' + lens.outcomeRateLabel.replace('actual ', '') + '</span> &middot; ' +
      '<span>simplest rule: ' + f.baseline + '%</span> &middot; ' +
      '<span class="' + liftClass + '">gain ' + formatSigned(f.lift) + ' pts</span><br>' +
      'Catches ' + f.recall + '% of ' + lens.caughtLabel.replace(' caught', '') + '; wrongly flags ' + formatPct(f.falseAlarm) + ' of ' + lens.falseLabel.replace(/ but were flagged$/, '');
  }

  function updateDataTable(lens) {
    var body = document.getElementById('simTableBody');
    body.innerHTML = '';
    [
      { f: segmentFacts(lens, 'A'), test: 100 - lens.testB, deploy: 100 - lens.deployB },
      { f: segmentFacts(lens, 'B'), test: lens.testB, deploy: lens.deployB }
    ].forEach(function (row) {
      var f = row.f;
      var tr = document.createElement('tr');
      [
        f.name,
        formatCount(f.n),
        row.test + '%',
        row.deploy + '%',
        f.rate + '%',
        f.accuracy + '%, margin of error plus or minus ' + formatPoints(f.margin) + ' points',
        f.baseline + '%',
        formatSigned(f.lift) + ' percentage points',
        f.recall + '%',
        formatPct(f.falseAlarm)
      ].forEach(function (value, index) {
        var cell = document.createElement(index === 0 ? 'th' : 'td');
        if (index === 0) { cell.setAttribute('scope', 'row'); }
        cell.textContent = value;
        tr.appendChild(cell);
      });
      body.appendChild(tr);
    });
    document.getElementById('simTableRateHead').textContent = 'Actual ' + lens.outcome + ' rate';
    document.getElementById('simTableCaughtHead').textContent = 'Share of actual ' + lens.outcome + ' cases caught';
    document.getElementById('simTableCaption').textContent = lens.label + ': testing set, expected deployment population, and what each segment result rests on';
  }

  function updateProjection(announce) {
    var lens = lenses[currentLensKey];
    var shareB = Number(mixRange.value);
    var projected = weightedPerformance(lens, shareB);
    var baseline = weightedBaseline(lens, shareB);
    var lift = projected - baseline;
    var testOverall = weightedPerformance(lens, lens.testB);
    var deploymentOverall = weightedPerformance(lens, lens.deployB);
    var liftEl = document.getElementById('liftValue');

    document.getElementById('mixOutput').textContent = shareB + '%';
    document.getElementById('projectionValue').textContent = formatPct(projected);
    document.getElementById('baselineValue').textContent = formatPct(baseline);
    liftEl.textContent = formatSigned(lift) + ' pts';
    liftEl.className = 'projection-value ' + (lift >= 0 ? 'lift-pos' : 'lift-neg');
    document.getElementById('projectionContext').textContent = 'Testing-set headline: ' + formatPct(testOverall) + '. Expected deployment mix: ' + formatPct(deploymentOverall) + '.';

    if (announce && window.maibAnnounce) {
      window.clearTimeout(announceTimer);
      announceTimer = window.setTimeout(function () {
        window.maibAnnounce('At ' + shareB + ' percent ' + lens.groupB.toLowerCase() + ': model accuracy ' +
          formatPct(projected) + ', simplest rule ' + formatPct(baseline) + ', gain ' + formatSigned(lift) + ' percentage points.');
      }, 500);
    }
  }

  function renderLens(key, announcement) {
    currentLensKey = key;
    currentStep = 0;
    var lens = lenses[key];
    lensButtons.forEach(function (button) {
      button.setAttribute('aria-pressed', String(button.getAttribute('data-lens') === key));
    });

    document.getElementById('scenarioTitle').textContent = lens.title;
    document.getElementById('scenarioText').textContent = lens.scenario;
    document.getElementById('testMixValue').textContent = lens.testB + '% ' + lens.groupB.toLowerCase();
    document.getElementById('deployMixValue').textContent = lens.deployB + '% ' + lens.groupB.toLowerCase();
    setMix('test', lens.testB);
    setMix('deploy', lens.deployB);
    document.getElementById('legendA').textContent = lens.groupA;
    document.getElementById('legendB').textContent = lens.groupB;
    document.getElementById('performanceNote').textContent = 'Accuracy is shown with the number of records it was measured on, the margin of error that count allows, and what the simplest rule, always predicting the more common outcome, would achieve without any model.';
    renderSegmentContext('A', lens);
    renderSegmentContext('B', lens);
    document.getElementById('rangeGroupLabel').textContent = lens.groupB.toLowerCase();
    document.getElementById('mixTargetText').innerHTML = 'Expected deployment: <strong>' + lens.deployB + '% ' + lens.groupB.toLowerCase() + '</strong>';
    mixRange.value = lens.testB;
    mixRange.setAttribute('aria-valuetext', lens.testB + ' percent ' + lens.groupB);
    updateProjection(false);
    updateDataTable(lens);
    renderPrediction(lens);

    var testOverall = weightedPerformance(lens, lens.testB);
    var deploymentOverall = weightedPerformance(lens, lens.deployB);
    var factsA = segmentFacts(lens, 'A');
    var factsB = segmentFacts(lens, 'B');
    document.getElementById('simChartDesc').textContent = lens.groupB + ' are ' + lens.testB + ' percent of the testing set and ' + lens.deployB + ' percent of expected deployment. Model accuracy is ' + factsA.accuracy + ' percent for ' + lens.groupA + ' against a no-model baseline of ' + factsA.baseline + ' percent, and ' + factsB.accuracy + ' percent for ' + lens.groupB + ' against a baseline of ' + factsB.baseline + ' percent. The testing-set headline is ' + formatPct(testOverall) + '; weighting the same segment performance by the expected deployment mix produces ' + formatPct(deploymentOverall) + '. Full figures follow in the simulation data table.';
    document.getElementById('lensLive').textContent = announcement || (lens.label + ' lens selected. The simulation and questions have been reset.');

    solutionSummary.classList.remove('show');
    quizPanel.style.display = 'block';
    renderQuestion();
  }

  /* ── Predict-first gate ──
     The projection stays hidden until the learner commits to an estimate, so the
     slider tests a prediction rather than simply displaying an answer. Any choice
     reveals the projection along with an explanation. */
  function renderPrediction(lens) {
    var testOverall = weightedPerformance(lens, lens.testB);
    var deploymentOverall = weightedPerformance(lens, lens.deployB);

    predictionMade = false;
    projectionBlock.hidden = true;
    predictBlock.hidden = false;
    predictResult.className = 'predict-result';
    predictResult.textContent = '';
    predictOptions.innerHTML = '';

    document.getElementById('predictPrompt').textContent =
      'The testing-set headline is ' + formatPct(testOverall) + '. If ' + lens.groupB.toLowerCase() +
      ' rise from ' + lens.testB + '% of the population to ' + lens.deployB + '%, and every segment keeps performing exactly as it did in testing, what happens to that headline?';

    [
      {
        label: 'It stays close to ' + formatPct(testOverall) + ', because the model itself has not changed',
        correct: false,
        feedback: 'Incorrect. The model has not changed, but the headline is a weighted average of segment results, so it moves whenever the weights move. The projection is ' + formatPct(deploymentOverall) + '.'
      },
      {
        label: 'It falls to about ' + formatPct(deploymentOverall) + ', a change of ' + formatPoints(testOverall - deploymentOverall) + ' points',
        correct: true,
        feedback: 'The headline is a weighted average. Reweighting the same segment results by the deployment mix gives ' + formatPct(deploymentOverall) + '.'
      },
      {
        label: 'It falls to about ' + lens.perfB + '%, the rate for ' + lens.groupB.toLowerCase(),
        correct: false,
        feedback: 'Incorrect. That would be the result only if ' + lens.groupB.toLowerCase() + ' made up the entire population. They are expected to be ' + lens.deployB + '% of it, so ' + lens.groupA.toLowerCase() + ' still carry the majority of the weight. The projection is ' + formatPct(deploymentOverall) + '.'
      }
    ].forEach(function (option, index) {
      var button = document.createElement('button');
      button.type = 'button';
      button.className = 'predict-option';
      var letter = document.createElement('span');
      letter.className = 'predict-option-letter';
      letter.setAttribute('aria-hidden', 'true');
      letter.textContent = OPTION_LETTERS[index];
      var text = document.createElement('span');
      text.className = 'predict-option-text';
      text.textContent = option.label;
      button.appendChild(letter);
      button.appendChild(text);
      button.addEventListener('click', function () { answerPrediction(option, button); });
      predictOptions.appendChild(button);
    });
  }

  function answerPrediction(option, selectedButton) {
    if (predictionMade) { return; }
    predictionMade = true;
    Array.prototype.forEach.call(predictOptions.querySelectorAll('.predict-option'), function (button) {
      button.disabled = true;
    });
    selectedButton.classList.add(option.correct ? 'chosen-correct' : 'chosen-incorrect');
    predictResult.innerHTML = '<strong>' + (option.correct ? 'Correct.' : 'Incorrect.') + '</strong> ' +
      option.feedback.replace(/^Incorrect\. /, '') + ' Adjust the mix to see how the projection responds across the whole range.';
    predictResult.classList.add('show');
    projectionBlock.hidden = false;
    if (window.maibAnnounce) {
      window.maibAnnounce((option.correct ? 'Correct. ' : 'Incorrect. ') + option.feedback.replace(/^Incorrect\. /, '') + ' The projection is now available.');
    }
  }

  function getQuestions(lens) {
    var testOverall = weightedPerformance(lens, lens.testB);
    var deploymentOverall = weightedPerformance(lens, lens.deployB);
    var drop = testOverall - deploymentOverall;
    var factsA = segmentFacts(lens, 'A');
    var factsB = segmentFacts(lens, 'B');
    return [
      {
        prompt: 'Which segment most limits how well the testing-set headline represents deployment?',
        options: [
          {
            label: lens.groupA,
            correct: false,
            feedback: 'Incorrect. ' + lens.groupA + ' are well represented in the testing set, their result rests on ' + formatCount(factsA.n) + ' records, and the model beats the no-model baseline there by ' + formatSigned(factsA.lift) + ' points. The reliability problem appears where representation and performance differ together.'
          },
          {
            label: lens.groupB,
            correct: true,
            feedback: 'The share of ' + lens.groupB.toLowerCase() + ' rises from ' + lens.testB + '% in testing to ' + lens.deployB + '% in deployment, their accuracy is ' + lens.perfB + '% against a no-model baseline of ' + factsB.baseline + '%, and that figure rests on only ' + formatCount(factsB.n) + ' records. Under the stable-segment assumption, the projected headline falls from ' + formatPct(testOverall) + ' to ' + formatPct(deploymentOverall) + ', a change of ' + formatPoints(drop) + ' percentage points.'
          },
          {
            label: 'Neither segment; population mix does not affect an overall result',
            correct: false,
            feedback: 'Incorrect. An overall result is a weighted average. When the lower-performing segment becomes a larger share of deployment, the headline changes even if each segment’s performance remains unchanged.'
          }
        ]
      },
      {
        prompt: 'Accuracy for ' + lens.groupB.toLowerCase() + ' is ' + lens.perfB + '%, and ' + lens.baseB + '% of that segment ends in ' + lens.outcome + '. What does that combination show?',
        options: [
          {
            label: 'The model performs worse on this segment but still adds useful signal',
            correct: false,
            feedback: 'Incorrect. Predicting the more common outcome for everyone in this segment would be right ' + factsB.baseline + '% of the time with no model at all. At ' + lens.perfB + '%, the model is ' + formatSigned(factsB.lift) + ' points against that floor, so it is not adding usable signal here.'
          },
          {
            label: 'The model performs no better than predicting the more common outcome for everyone',
            correct: true,
            feedback: 'With ' + lens.baseB + '% of the segment ending in ' + lens.outcome + ', always predicting the more common outcome scores ' + factsB.baseline + '%. The model scores ' + lens.perfB + '%, a difference of ' + formatSigned(factsB.lift) + ' points. Accuracy read against zero looks like a weak result; read against the floor it is no result. The ' + formatCount(factsB.n) + ' records behind it carry a margin of about ' + formatPoints(factsB.margin) + ' points, which is wider than the difference itself.'
          },
          {
            label: 'Accuracy cannot be interpreted without knowing the model type',
            correct: false,
            feedback: 'Incorrect. The model type governs how a prediction is explained, not how a metric is read. Any accuracy figure can be compared against what the simplest rule would achieve on the same data, and that comparison needs only the outcome rate.'
          }
        ]
      },
      {
        prompt: 'What does the held-out testing result support?',
        options: [
          {
            label: 'The model can handle unseen ' + lens.unit + ' drawn from a similar population and historical period',
            correct: true,
            feedback: 'A held-out test checks performance on records the model did not use during training. That evidence is most relevant when deployment resembles the population and period represented in the test.'
          },
          {
            label: 'The model will achieve the testing-set headline at the expected deployment mix',
            correct: false,
            feedback: 'Incorrect. The testing-set headline weights segment performance using the testing mix. This simulation produces ' + formatPct(deploymentOverall) + ' at the expected deployment mix, even before considering any new change in the operating environment.'
          },
          {
            label: 'The model will remain reliable after ' + lens.futureShift,
            correct: false,
            feedback: 'Incorrect. Both training and testing data come from the historical period before ' + lens.futureShift + '. A split from that same file cannot test a condition the file does not contain.'
          }
        ]
      },
      {
        prompt: 'Which plan responds to both the population mismatch and the unseen future change?',
        options: [
          {
            label: 'Approve deployment because the overall testing result is based on held-out data',
            correct: false,
            feedback: 'Incorrect. Holding data back prevents evaluation on the training records, but it does not correct the population mismatch or represent ' + lens.futureShift + '. ' + lens.consequence
          },
          {
            label: 'Require representative evaluation, subgroup results against a no-model baseline, and an owned monitoring plan',
            correct: true,
            feedback: lens.prelaunch + ' Report each segment against what the simplest rule would achieve, with the record count behind it. After launch, ' + lens.owners + ' should monitor ' + lens.monitor + ' and define when a change requires review, retraining, or suspension.'
          },
          {
            label: 'Add more historical records from ' + lens.groupA.toLowerCase() + ' and rerun the same overall metric',
            correct: false,
            feedback: 'Incorrect. More records from the better-represented segment do not make the test resemble deployment. The same overall metric would continue to hide the performance gap for ' + lens.groupB.toLowerCase() + '.'
          }
        ]
      }
    ];
  }

  function hideFeedback() {
    quizFeedback.className = 'quiz-feedback';
    document.getElementById('feedbackTitle').textContent = '';
    document.getElementById('feedbackText').textContent = '';
    feedbackActions.innerHTML = '';
  }

  function focusFirstOption() {
    var first = quizOptions.querySelector('.quiz-option');
    if (first) { first.focus(); }
  }

  function renderQuestion() {
    var lens = lenses[currentLensKey];
    var questions = getQuestions(lens);
    var question = questions[currentStep];
    document.getElementById('quizProgress').textContent = 'Decision ' + (currentStep + 1) + ' of ' + questions.length;
    document.getElementById('quizQuestion').textContent = question.prompt;
    quizOptions.innerHTML = '';
    hideFeedback();

    question.options.forEach(function (option, index) {
      var button = document.createElement('button');
      button.type = 'button';
      button.className = 'quiz-option';
      var letter = document.createElement('span');
      letter.className = 'quiz-option-letter';
      letter.setAttribute('aria-hidden', 'true');
      letter.textContent = OPTION_LETTERS[index];
      var text = document.createElement('span');
      text.className = 'quiz-option-text';
      text.textContent = option.label;
      button.appendChild(letter);
      button.appendChild(text);
      button.addEventListener('click', function () { answerQuestion(option, button); });
      quizOptions.appendChild(button);
    });
  }

  function addFeedbackButton(label, className, action) {
    var button = document.createElement('button');
    button.type = 'button';
    button.className = className;
    button.textContent = label;
    button.addEventListener('click', action);
    feedbackActions.appendChild(button);
  }

  function answerQuestion(option, selectedButton) {
    var questions = getQuestions(lenses[currentLensKey]);
    Array.prototype.forEach.call(quizOptions.querySelectorAll('.quiz-option'), function (button) {
      button.disabled = true;
    });
    selectedButton.classList.add(option.correct ? 'correct' : 'incorrect');
    quizFeedback.className = 'quiz-feedback show ' + (option.correct ? 'correct' : 'incorrect');
    document.getElementById('feedbackTitle').textContent = option.correct ? 'Correct.' : 'Incorrect.';
    document.getElementById('feedbackText').textContent = option.feedback;
    feedbackActions.innerHTML = '';

    if (option.correct) {
      if (currentStep < questions.length - 1) {
        addFeedbackButton('Continue', 'btn-action', function () {
          currentStep += 1;
          renderQuestion();
          focusFirstOption();
        });
      } else {
        addFeedbackButton('View complete explanation', 'btn-action', showSolution);
      }
    } else {
      addFeedbackButton('Try again', 'btn-action secondary', function () {
        renderQuestion();
        focusFirstOption();
      });
    }

    /* Move focus to the feedback rather than to the button inside it. The container
       carries the title as its accessible name and the explanation as its description,
       so the whole result is announced once, and the action button is the next tab
       stop. Focusing the button directly could cut the announcement short. */
    quizFeedback.focus();
  }

  function appendSolutionItem(container, title, text) {
    var item = document.createElement('div');
    item.className = 'solution-item';
    var heading = document.createElement('strong');
    heading.textContent = title;
    var body = document.createElement('p');
    body.textContent = text;
    item.appendChild(heading);
    item.appendChild(body);
    container.appendChild(item);
  }

  function showSolution() {
    var lens = lenses[currentLensKey];
    var testOverall = weightedPerformance(lens, lens.testB);
    var deploymentOverall = weightedPerformance(lens, lens.deployB);
    var testLift = testOverall - weightedBaseline(lens, lens.testB);
    var deployLift = deploymentOverall - weightedBaseline(lens, lens.deployB);
    var factsB = segmentFacts(lens, 'B');
    quizPanel.style.display = 'none';
    solutionSummary.classList.add('show');
    document.getElementById('solutionIntro').textContent = lens.label + ': the testing set provides useful evidence, and the evidence has four limits.';
    var list = document.getElementById('solutionList');
    list.innerHTML = '';
    appendSolutionItem(list, '1. Representation', lens.groupB + ' rise from ' + lens.testB + '% of testing to ' + lens.deployB + '% of deployment and have the lower accuracy. Reweighting the same segment results changes the headline from ' + formatPct(testOverall) + ' to ' + formatPct(deploymentOverall) + '.');
    appendSolutionItem(list, '2. The comparison that is missing', 'Read against a no-model baseline rather than against zero, the gain is ' + formatSigned(testLift) + ' points at the testing mix and ' + formatSigned(deployLift) + ' points at the deployment mix. For ' + lens.groupB.toLowerCase() + ' on their own the gain is ' + formatSigned(factsB.lift) + ' points, so the model is not beating the simplest rule in the segment that is about to grow.');
    appendSolutionItem(list, '3. How much the numbers can bear', 'The ' + lens.groupB.toLowerCase() + ' result rests on ' + formatCount(factsB.n) + ' records, a margin of roughly ' + formatPoints(factsB.margin) + ' percentage points. That is wider than the gap it is being used to argue about, so the segment figure should be treated as a range, not a point.');
    appendSolutionItem(list, '4. Supported claim and required action', 'The held-out test supports performance on unseen ' + lens.unit + ' from a similar historical population. It does not establish performance after ' + lens.futureShift + '. ' + lens.prelaunch + ' After launch, ' + lens.owners + ' should monitor ' + lens.monitor + '.');
    solutionSummary.focus();
  }

  lensButtons.forEach(function (button) {
    button.addEventListener('click', function () {
      renderLens(button.getAttribute('data-lens'));
    });
  });

  function dismissSliderHint() {
    var hint = document.getElementById('mixHint');
    if (hint) { hint.remove(); }
  }

  mixRange.addEventListener('input', function () {
    var lens = lenses[currentLensKey];
    mixRange.setAttribute('aria-valuetext', mixRange.value + ' percent ' + lens.groupB);
    dismissSliderHint();
    updateProjection(true);
  });

  document.getElementById('matchDeployment').addEventListener('click', function () {
    var lens = lenses[currentLensKey];
    mixRange.value = lens.deployB;
    mixRange.setAttribute('aria-valuetext', lens.deployB + ' percent ' + lens.groupB);
    dismissSliderHint();
    updateProjection(true);
    if (projectionBlock.hidden) {
      predictionMade = true;
      projectionBlock.hidden = false;
      Array.prototype.forEach.call(predictOptions.querySelectorAll('.predict-option'), function (button) {
        button.disabled = true;
      });
      predictResult.textContent = 'The projection is now shown. The estimate step is skipped.';
      predictResult.classList.add('show');
    }
  });

  document.getElementById('restartSimulation').addEventListener('click', function () {
    renderLens(currentLensKey, 'Simulation restarted. Decision 1 of ' + getQuestions(lenses[currentLensKey]).length + '.');
    focusFirstOption();
  });

  renderLens('media');

})();
</script>

<!-- VOCAB TERM DISCLOSURE -->
<script>
(function () {
  function enhanceVocabTerms(root) {
    var scope = root || document;
    var terms = scope.querySelectorAll('span.vocab[title]');
    Array.prototype.forEach.call(terms, function (span) {
      if (span.dataset.vocabEnhanced) return;
      span.dataset.vocabEnhanced = 'true';

      var definition = span.getAttribute('title');
      var termText = span.textContent;
      var id = 'vocabDef-' + Math.random().toString(36).slice(2, 10);

      var btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'vocab-term';
      btn.setAttribute('aria-expanded', 'false');
      btn.setAttribute('aria-controls', id);
      btn.textContent = termText;

      var srHint = document.createElement('span');
      srHint.className = 'vocab-sr';
      srHint.textContent = ' (select to view definition)';
      btn.appendChild(srHint);

      var defEl = document.createElement('span');
      defEl.className = 'vocab-definition';
      defEl.id = id;
      defEl.setAttribute('role', 'note');
      defEl.hidden = true;
      defEl.textContent = definition;

      span.replaceWith(btn, defEl);

      btn.addEventListener('click', function () {
        var isOpen = btn.getAttribute('aria-expanded') === 'true';
        btn.setAttribute('aria-expanded', String(!isOpen));
        defEl.hidden = isOpen;
      });

      btn.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') {
          btn.setAttribute('aria-expanded', 'false');
          defEl.hidden = true;
          btn.focus();
        }
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function () { enhanceVocabTerms(document); });
  } else {
    enhanceVocabTerms(document);
  }

  if (window.MutationObserver) {
    var vocabObserver = new MutationObserver(function (mutations) {
      mutations.forEach(function (m) {
        Array.prototype.forEach.call(m.addedNodes || [], function (node) {
          if (node.nodeType === 1) enhanceVocabTerms(node);
        });
      });
    });
    vocabObserver.observe(document.body || document.documentElement, { childList: true, subtree: true });
  }
})();
</script>
</body>
</html>
